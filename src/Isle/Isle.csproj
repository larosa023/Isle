<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Isle</AssemblyName>
    <RootNamespace>Isle</RootNamespace>
    <Product>Isle</Product>
    <Company>Anthony LaRosa</Company>
    <Copyright>© 2026 Anthony LaRosa</Copyright>
    <Description>A Dynamic Island for Windows.</Description>
    <!-- CI overrides this from the git tag (v1.2.3 -> 1.2.3). -->
    <VersionPrefix>0.7.0</VersionPrefix>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\isle.ico</ApplicationIcon>

    <!-- Keep the footprint small: workstation, non-concurrent GC; English resources only. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Faster start: Isle's own code is precompiled (the .NET framework already is). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>

    <!-- WPF0001: Fluent ThemeMode is marked experimental; used only by the settings window. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Built with -p:IsleFlavor=standalone for the self-contained download, so the updater
       fetches the same flavor it is running as. -->
  <PropertyGroup Condition="'$(IsleFlavor)' == 'standalone'">
    <DefineConstants>$(DefineConstants);STANDALONE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\isle.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ask the garbage collector to favor a small heap over raw allocation speed. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

</Project>
