<Window x:Class="Isle.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Settings" Width="940" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- On/off switch, Windows 11 style -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="State" Text="Off" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.75"/>
                            <Grid Width="40" Height="20">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="Transparent"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0.75"/>
                                <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="State" Property="Text" Value="On"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                <Setter TargetName="Track" Property="Opacity" Value="1"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14"/>
                                <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="12,18,6,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,20">
                <Image Source="pack://application:,,,/Assets/isle.ico" Width="30" Height="30"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Isle" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="4,0,4,12" TextChanged="Search_TextChanged"
                     ToolTip="Search every setting (Ctrl+F)"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
                <Button x:Name="PreviewButton" HorizontalAlignment="Stretch" Padding="10,6" Click="Preview_Click"
                        ToolTip="Puts a sample card on the island so you can see your changes"/>
                <TextBlock Margin="8,10,8,0" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" Text="Changes apply instantly."/>
            </StackPanel>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Nav_SelectionChanged"/>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Page" Margin="24,22,32,32" MaxWidth="780"/>
        </ScrollViewer>
    </Grid>
</Window>
