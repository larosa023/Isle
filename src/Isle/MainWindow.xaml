<Window x:Class="Isle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Isle.Controls"
        Title="Isle Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="480" Height="230"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource Island.Foreground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}"/>
            <Setter Property="Background" Value="{DynamicResource Island.Button}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="17" MinWidth="36" Height="34" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Island.Secondary}"/>
        </Style>
    </Window.Resources>

    <!-- The root has no background, so everything outside the pill is click-through. -->
    <Grid x:Name="Root">
      <Grid x:Name="Stage" VerticalAlignment="Top" Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Col0" Width="*"/>
            <ColumnDefinition x:Name="Col1" Width="Auto"/>
            <ColumnDefinition x:Name="Col2" Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Pill" Grid.Column="1"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="120" Height="30" CornerRadius="15" RenderTransformOrigin="0.5,0"
                Background="{DynamicResource Island.Background}"
                BorderBrush="{DynamicResource Island.Border}" BorderThickness="1"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                MouseLeftButtonUp="Pill_Click" MouseRightButtonUp="Pill_RightClick"
                MouseWheel="Pill_Wheel" SizeChanged="Pill_SizeChanged">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale"/>
            </Border.RenderTransform>
            <Grid x:Name="PillContent">

                <!-- Soft album-art color behind the open card (a 5×5 image, smoothly stretched). -->
                <Border x:Name="GlowLayer" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                        <ImageBrush x:Name="GlowBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- ───────────── Compact: leading art · title · trailing ───────────── -->
                <Grid x:Name="CompactLayer" Margin="7,0,14,0" HorizontalAlignment="Center" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="CompactArtHost" Margin="0,0,9,0" VerticalAlignment="Center">
                      <Grid Width="22" Height="22" Visibility="{Binding ShowSingleArt, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="11" Background="{Binding AccentBrush}"
                                Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="6" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Faces}" Focusable="False" Margin="7,-1,0,-1"
                                      Visibility="{Binding HasFaces, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="24" Height="24" CornerRadius="12.0" Margin="-8,0,0,0" BorderThickness="2"
                                            BorderBrush="{DynamicResource Island.Background}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock x:Name="CompactTitle" Grid.Column="1" Text="{Binding CompactTitle}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <Border x:Name="CompactProgressHost" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource Island.Track}"
                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                            <Border CornerRadius="1" Background="{Binding AccentBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding ProgressValue}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border x:Name="CompactLiveHost" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding AccentBrush}" VerticalAlignment="Center"
                                     Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                        </Border>
                        <StackPanel x:Name="CompactTrailingHost" Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Visualizer BarBrush="{Binding AccentBrush}" BarHeight="13" IsActive="{Binding ShowVisualizer}"
                                          Visibility="{Binding ShowVisualizer, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Trailing}" FontSize="12.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                       Foreground="{Binding AccentBrush}"
                                       Visibility="{Binding HasTrailing, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ───────────── Idle pill with a clock (optional) ───────────── -->
                <TextBlock x:Name="IdleCompactLayer" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="SemiBold" Opacity="0" Visibility="Hidden" IsHitTestVisible="False"/>

                <!-- ───────────── Expanded activity ───────────── -->
                <Grid x:Name="ExpandedLayer" Margin="18,16,18,15" VerticalAlignment="Top" HorizontalAlignment="Center"
                      Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="54" Height="54" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border CornerRadius="27" Background="{Binding AccentBrush}"
                                    Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="22"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="13" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border x:Name="SourceHost">
                                <TextBlock Text="{Binding Source}" FontSize="11" Style="{StaticResource Secondary}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,1"
                                           Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Style="{StaticResource Secondary}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,1,0,0"
                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Faces}" Focusable="False" Margin="7,6,0,0"
                                      Visibility="{Binding HasFaces, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="28" Height="28" CornerRadius="14.0" Margin="-7,0,0,0" BorderThickness="2"
                                            BorderBrush="{DynamicResource Island.Background}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="PositionText" FontSize="10.5" Style="{StaticResource Secondary}"
                                       HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <c:Visualizer BarBrush="{Binding AccentBrush}" BarHeight="20" IsActive="{Binding ShowVisualizer}"
                                          HorizontalAlignment="Right"
                                          Visibility="{Binding ShowVisualizer, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Badge}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                       Foreground="{Binding AccentBrush}"
                                       Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- The current lyric line (synced lyrics). Fixed height, so line changes never resize the island. -->
                    <Grid x:Name="LyricHost" Grid.Row="1" Height="44" Margin="0,12,0,-2" ClipToBounds="True"
                          Visibility="{Binding HasLyric, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="LyricText" Text="{Binding Lyric}" FontSize="15" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Border x:Name="ProgressHost" Grid.Row="2">
                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressLeft}" FontSize="11" Typography.NumeralAlignment="Tabular" Style="{StaticResource Secondary}"
                                   MinWidth="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Grid x:Name="SeekArea" Grid.Column="1" Height="16" Background="Transparent" MouseLeftButtonUp="Seek_Click">
                            <Border x:Name="SeekTrack" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource Island.Track}">
                                <Border CornerRadius="2" Background="{Binding AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ProgressValue}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding ProgressRight}" FontSize="11" Typography.NumeralAlignment="Tabular" Style="{StaticResource Secondary}"
                                   MinWidth="32" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    </Border>

                    <Border x:Name="ActionsHost" Grid.Row="3">
                    <ItemsControl ItemsSource="{Binding Actions}" HorizontalAlignment="Center" Margin="0,13,0,0"
                                  Focusable="False"
                                  Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Btn" Style="{StaticResource IslandButton}" Click="OnActionClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Label}" Margin="{Binding LabelMargin}" VerticalAlignment="Center"
                                                   Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Primary}" Value="True">
                                        <Setter TargetName="Btn" Property="Background" Value="{DynamicResource Island.PrimaryButton}"/>
                                        <Setter TargetName="Btn" Property="Foreground" Value="{DynamicResource Island.PrimaryButtonText}"/>
                                        <Setter TargetName="Icon" Property="FontSize" Value="16"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                </Grid>

                <!-- ───────────── Expanded with nothing going on: clock, weather, quick actions ───────────── -->
                <Grid x:Name="IdleLayer" Margin="20,14,20,16" VerticalAlignment="Top" HorizontalAlignment="Center"
                      Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="IdleTime" FontSize="28" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="IdleDate" FontSize="12.5" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                        <StackPanel x:Name="WeatherPanel" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="WeatherGlyph" FontFamily="Segoe UI Symbol" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="WeatherTemp" FontSize="28" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <TextBlock x:Name="WeatherText" FontSize="12" Style="{StaticResource Secondary}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel x:Name="QuickTimersPanel" Grid.Row="1" Orientation="Horizontal" Margin="-4,12,0,0"/>
                </Grid>

            </Grid>
        </Border>

        <!-- A second live activity, as a small bubble beside the pill. Click it to switch. -->
        <Border x:Name="Bubble" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0"
                Height="36" MinWidth="36" CornerRadius="18" Padding="7,0" Cursor="Hand"
                Background="{DynamicResource Island.Background}" BorderBrush="{DynamicResource Island.Border}" BorderThickness="1"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonUp="Bubble_Click" MouseRightButtonUp="Pill_RightClick">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="0.4" ScaleY="0.4"/>
            </Border.RenderTransform>
            <StackPanel x:Name="BubbleContent" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="22" Height="22">
                    <Border CornerRadius="11" Background="{Binding AccentBrush}"
                            Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="6" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock x:Name="BubbleText" Text="{Binding Trailing}" FontSize="12" FontWeight="SemiBold" Margin="7,0,2,0"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Foreground="{Binding AccentBrush}"
                           Visibility="{Binding HasTrailing, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
      </Grid>
    </Grid>
</Window>
